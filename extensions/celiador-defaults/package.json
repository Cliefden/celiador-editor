{
  "name": "celiador-defaults",
  "displayName": "Celiador Defaults",
  "description": "Ships Celiador's default settings — enables the native agent (daemon-routed) for chat and inline edit, and turns off Microsoft telemetry/updates/walkthroughs for a clean Celiador first run.",
  "version": "1.0.0",
  "publisher": "celiador",
  "license": "MIT",
  "engines": {
    "vscode": "*"
  },
  "contributes": {
    "configurationDefaults": {
      "chat.disableAIFeatures": false,
      "chat.agentHost.claudeAgent.enabled": true,
      "chat.agentHost.codexAgent.enabled": false,
      "chat.inlineChat.agentHost.enabled": true,
      "telemetry.telemetryLevel": "off",
      "update.mode": "none",
      "workbench.welcomePage.walkthroughs.openOnInstall": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cliefden/celiador.git"
  }
}
