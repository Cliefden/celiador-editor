{
  "name": "celiador-ai",
  "displayName": "Celiador AI",
  "description": "Celiador's identity + companion shell — sign-in, auth provider, and git-review view for the native Celiador agent.",
  "version": "0.0.2",
  "publisher": "celiador",
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, workspace settings cannot change where Celiador sends your credentials (daemon / sign-in URLs).",
      "restrictedConfigurations": [
        "celiador.daemonUrl",
        "celiador.supabaseUrl"
      ]
    }
  },
  "contributes": {
    "authentication": [
      {
        "id": "celiador",
        "label": "Celiador",
        "authorizationServerGlobs": [
          "https://celiador.ai",
          "https://celiador.ai/*",
          "https://staging.celiador.ai",
          "https://staging.celiador.ai/*",
          "http://localhost:*",
          "http://localhost:*/*",
          "http://127.0.0.1:*",
          "http://127.0.0.1:*/*"
        ]
      }
    ],
    "commands": [
      {
        "command": "celiador.checkConnection",
        "title": "Celiador: Check Daemon Connection",
        "category": "Celiador"
      },
      {
        "command": "celiador.signIn",
        "title": "Celiador: Sign In",
        "category": "Celiador"
      },
      {
        "command": "celiador.signOut",
        "title": "Celiador: Sign Out",
        "category": "Celiador"
      },
      {
        "command": "celiador.account",
        "title": "Celiador: Account",
        "category": "Celiador"
      },
      {
        "command": "celiador.pastChats",
        "title": "Celiador: Past Chats",
        "category": "Celiador"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "celiador",
          "title": "Celiador",
          "icon": "media/celiador.svg"
        }
      ]
    },
    "views": {
      "celiador": [
        {
          "id": "celiador.changes",
          "name": "Changes",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Celiador",
      "properties": {
        "celiador.daemonUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of the Celiador daemon. Leave empty to use this build's default (`celiadorDaemonUrl` in `product.json`): prod → `https://celiador.ai`, staging → `https://staging.celiador.ai`, dev → `http://localhost:4661`.",
          "scope": "application"
        },
        "celiador.supabaseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the Supabase/GoTrue base URL used for sign-in. Leave empty to use the value from the daemon's `GET /api/config` (self-hosted defaults to the daemon URL).",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.138.0",
    "typescript": "^5.6.0"
  }
}
