{
  "name": "celiador-ai",
  "displayName": "Celiador AI",
  "description": "Celiador's identity + companion shell — sign-in, auth provider, and git-review view for the native Celiador agent.",
  "version": "0.0.2",
  "publisher": "celiador",
  "license": "MIT",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./out/extension.js",
  "enabledApiProposals": [
    "authIssuers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, workspace settings cannot change where Celiador sends your credentials (daemon / sign-in URLs).",
      "restrictedConfigurations": [
        "celiador.daemonUrl",
        "celiador.supabaseUrl"
      ]
    }
  },
  "contributes": {
    "authentication": [
      {
        "id": "celiador",
        "label": "Celiador",
        "authorizationServerGlobs": [
          "https://celiador.ai",
          "https://celiador.ai/*",
          "https://staging.celiador.ai",
          "https://staging.celiador.ai/*",
          "http://localhost:*",
          "http://localhost:*/*",
          "http://127.0.0.1:*",
          "http://127.0.0.1:*/*"
        ]
      }
    ],
    "commands": [
      {
        "command": "celiador.checkConnection",
        "title": "Celiador: Check Daemon Connection",
        "category": "Celiador"
      },
      {
        "command": "celiador.signIn",
        "title": "Celiador: Sign In",
        "category": "Celiador"
      },
      {
        "command": "celiador.signOut",
        "title": "Celiador: Sign Out",
        "category": "Celiador"
      },
      {
        "command": "celiador.account",
        "title": "Celiador: Account",
        "category": "Celiador"
      },
      {
        "command": "celiador.pastChats",
        "title": "Celiador: Past Chats",
        "category": "Celiador"
      },
      {
        "command": "celiador.manageBilling",
        "title": "Celiador: Manage Billing",
        "category": "Celiador"
      },
      {
        "command": "celiador.toggleInlineCompletions",
        "title": "Celiador: Toggle Tab Autocomplete",
        "category": "Celiador"
      },
      {
        "command": "celiador.deleteAccount",
        "title": "Celiador: Delete Account",
        "category": "Celiador"
      }
    ],
    "views": {
      "chat": [
        {
          "id": "celiador.welcome",
          "name": "Account",
          "type": "webview",
          "visibility": "collapsed"
        },
        {
          "id": "celiador.changes",
          "name": "Changes",
          "type": "webview",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "Celiador",
      "properties": {
        "celiador.daemonUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of the Celiador daemon. Leave empty to use this build's default (`celiadorDaemonUrl` in `product.json`): prod → `https://celiador.ai`, staging → `https://staging.celiador.ai`, dev → `http://localhost:4661`.",
          "scope": "application",
          "restricted": true
        },
        "celiador.supabaseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the Supabase/GoTrue base URL used for sign-in. Leave empty to use the value from the daemon's `GET /api/config` (self-hosted defaults to the daemon URL).",
          "scope": "application",
          "restricted": true
        },
        "celiador.inlineCompletions.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Experimental: show model-backed inline \"Tab autocomplete\" suggestions as you type, routed through the Celiador daemon. Off by default — the agent (⌘I inline edit and the Agents view) is the primary way to get Celiador's help; Tab autocomplete is a lighter-weight convenience and may be less reliable.",
          "scope": "application"
        },
        "celiador.inlineCompletions.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "markdownDescription": "How long to wait after you stop typing before requesting a Tab-autocomplete suggestion. Lower feels snappier but sends more requests.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:unit": "npm run compile && node ./out/test/unit/run-unit-tests.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vscode/test-electron": "^2.3.0",
    "glob": "^10.0.0",
    "mocha": "^10.2.0",
    "typescript": "^5.6.0"
  }
}
